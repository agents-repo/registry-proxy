{
  "name": "registry-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker proxy for registry assets with governance and CI automation.",
  "scripts": {
    "env:check": "node scripts/validate-env.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\"",
    "lint:js": "eslint \"**/*.{js,mjs}\"",
    "lint:yaml": "node scripts/lint-yaml.js",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "lint:all": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\" && eslint \"**/*.{js,mjs}\" && node scripts/lint-yaml.js && node scripts/lint-workflows.mjs",
    "slides:build": "node scripts/slides.mjs build",
    "slides:preview:html": "node scripts/slides.mjs preview",
    "slides:check": "node scripts/slides.mjs check",
    "sync:ide-instructions": "node scripts/sync-ide-instructions.mjs",
    "agents:install": "agents-repo install",
    "agents:update": "agents-repo update",
    "agents:ci": "agents-repo ci",
    "test:sync": "node --test test/sync-ide-instructions.test.mjs test/commit-analyzer-rules.test.mjs test/ci-pr-path-filters.test.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "test": "npm run test:sync && node --test 'test/**/*.test.js'",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "engines": {
    "node": "24.18.0"
  },
  "packageManager": "npm@12.0.1",
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.0",
    "@marp-team/marp-core": "4.4.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "agents-repo": "1.20.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.1",
    "markdownlint-cli2": "^0.23.2",
    "semantic-release": "^25.0.6"
  },
  "overrides": {
    "brace-expansion@^1": "1.1.18",
    "brace-expansion@^2": "2.1.4",
    "brace-expansion@^5": "5.0.9",
    "ip-address@^10": "^10.4.0",
    "tar@^7": "^7.5.22",
    "undici@^6": "^6.28.0",
    "undici@^7": "^7.29.0",
    "undici@^8": "^8.9.0",
    "js-yaml@^3": "3.15.1",
    "js-yaml@^5": "5.2.2"
  }
}
