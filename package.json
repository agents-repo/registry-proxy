{
  "name": "registry-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker proxy for registry assets with governance and CI automation.",
  "scripts": {
    "env:check": "node scripts/validate-env.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\"",
    "lint:js": "eslint \"**/*.{js,mjs}\"",
    "lint:yaml": "node scripts/lint-yaml.js",
    "lint:all": "npm run lint:md && npm run lint:js && npm run lint:yaml",
    "sync:cursor-rules": "node scripts/sync-cursor-rules.mjs",
    "test:sync": "node --test test/sync-cursor-rules.test.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "test": "npm run test:sync && node --test 'test/**/*.test.js'",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.0",
    "markdownlint-cli2": "^0.23.0",
    "semantic-release": "^25.0.6"
  }
}
