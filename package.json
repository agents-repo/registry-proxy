{
  "name": "registry-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker proxy for registry assets with governance and CI automation.",
  "scripts": {
    "env:check": "node scripts/validate-env.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/.*/**/*.md\"",
    "lint:js": "eslint \"**/*.js\"",
    "lint:yaml": "node scripts/lint-yaml.js",
    "lint:all": "npm run lint:md && npm run lint:js && npm run lint:yaml",
    "check:secrets": "bash scripts/check-secrets.sh",
    "test": "node --test",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "markdownlint-cli2": "^0.18.1",
    "semantic-release": "^24.2.7",
    "yaml-lint": "^1.7.0"
  }
}
